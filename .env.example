# SEC EDGAR -- no API key, but SEC requires a User-Agent with your name + contact email.
SEC_USER_AGENT=Your Name your.email@example.com

# Supabase -- Project Settings -> API. Use the service_role key, NOT the anon
# key: this app writes to the database and storage from the server side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_MODEL_BUCKET=models

# Flask
SECRET_KEY=change-me
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional tuning
# SEC_REQUEST_INTERVAL_SECONDS=0.15
# CACHE_DIR=data/cache
# CACHE_TTL_SECONDS=86400
# LOCAL_MODEL_DIR=
